<Window x:Class="DeskNest.MainWindow"
        x:Name="RootWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:models="clr-namespace:DeskNest.Models"
        mc:Ignorable="d"
        Title="DeskNest"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        ResizeMode="NoResize"
        ShowInTaskbar="False"
        Loaded="Window_Loaded"
        SourceInitialized="Window_SourceInitialized"
        Closing="Window_Closing"
        PreviewKeyDown="Window_PreviewKeyDown">
  <Window.Resources>
    <SolidColorBrush x:Key="PanelBrush" Color="#E60A1421" />
    <SolidColorBrush x:Key="MutedBrush" Color="#FF9FB1C5" />

    <Style x:Key="ToolbarButton" TargetType="Button">
      <Setter Property="Foreground" Value="#FFF2F8FC" />
      <Setter Property="Background" Value="#16FFFFFF" />
      <Setter Property="BorderBrush" Value="#20FFFFFF" />
      <Setter Property="BorderThickness" Value="1" />
      <Setter Property="Padding" Value="13,8" />
      <Setter Property="Margin" Value="3,0" />
      <Setter Property="Cursor" Value="Hand" />
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="Button">
            <Border x:Name="Border" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}"
                    BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="9" Padding="{TemplateBinding Padding}">
              <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
            </Border>
            <ControlTemplate.Triggers>
              <Trigger Property="IsMouseOver" Value="True">
                <Setter TargetName="Border" Property="Background" Value="#28FFFFFF" />
                <Setter TargetName="Border" Property="BorderBrush" Value="#4065E6FF" />
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>

    <Style x:Key="HeaderButton" TargetType="Button" BasedOn="{StaticResource ToolbarButton}">
      <Setter Property="Width" Value="28" />
      <Setter Property="Height" Value="28" />
      <Setter Property="Padding" Value="0" />
      <Setter Property="Margin" Value="2,0" />
      <Setter Property="FontSize" Value="16" />
    </Style>
  </Window.Resources>

  <Grid x:Name="RootGrid" Background="{x:Null}">
    <ItemsControl x:Name="FenceItemsControl" ItemsSource="{Binding Groups}">
      <ItemsControl.ItemsPanel>
        <ItemsPanelTemplate>
          <Canvas />
        </ItemsPanelTemplate>
      </ItemsControl.ItemsPanel>
      <ItemsControl.ItemContainerStyle>
        <Style TargetType="ContentPresenter">
          <Setter Property="Canvas.Left" Value="{Binding X}" />
          <Setter Property="Canvas.Top" Value="{Binding Y}" />
          <Setter Property="Width" Value="{Binding Width}" />
          <Setter Property="Height" Value="{Binding Height}" />
        </Style>
      </ItemsControl.ItemContainerStyle>
      <ItemsControl.ItemTemplate>
        <DataTemplate DataType="{x:Type models:FenceGroup}">
          <Border x:Name="FenceCard"
                  MinWidth="260" MinHeight="210"
                  Background="{StaticResource PanelBrush}"
                  BorderBrush="{Binding Accent}"
                  BorderThickness="1"
                  CornerRadius="16"
                  Opacity="{Binding DataContext.PanelOpacity, RelativeSource={RelativeSource AncestorType=Window}}"
                  AllowDrop="True"
                  DragOver="Fence_DragOver"
                  Drop="Fence_Drop">
            <Border.Effect>
              <DropShadowEffect BlurRadius="26" ShadowDepth="8" Opacity="0.42" Color="#FF000000" />
            </Border.Effect>
            <Grid ClipToBounds="True">
              <Grid.RowDefinitions>
                <RowDefinition Height="48" />
                <RowDefinition Height="*" />
              </Grid.RowDefinitions>

              <Border x:Name="DragHeader" Grid.Row="0" Background="#12FFFFFF" CornerRadius="16,16,0,0"
                      PreviewMouseLeftButtonDown="FenceHeader_MouseLeftButtonDown"
                      PreviewMouseMove="FenceHeader_MouseMove"
                      PreviewMouseLeftButtonUp="FenceHeader_MouseLeftButtonUp">
                <Grid Margin="13,0,9,0">
                  <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                  </Grid.ColumnDefinitions>
                  <TextBox Grid.Column="0" Text="{Binding Title, UpdateSourceTrigger=PropertyChanged}"
                           Foreground="#FFF7FBFF" Background="Transparent" BorderThickness="0"
                           FontWeight="SemiBold" FontSize="15" VerticalContentAlignment="Center"
                           CaretBrush="#FF65E6FF" LostFocus="EditableText_LostFocus" />
                  <Button Grid.Column="1" Style="{StaticResource HeaderButton}" Content="+" ToolTip="Add tab"
                          Click="AddTab_Click" />
                  <Button Grid.Column="2" Style="{StaticResource HeaderButton}" Content="×" ToolTip="Remove group"
                          Click="DeleteFence_Click" />
                </Grid>
              </Border>

              <TabControl Grid.Row="1" ItemsSource="{Binding Tabs}" SelectedItem="{Binding SelectedTab, Mode=TwoWay}"
                          Background="Transparent" BorderThickness="0" Margin="7,0,7,7"
                          SelectionChanged="Tabs_SelectionChanged">
                <TabControl.Resources>
                  <Style TargetType="TabItem">
                    <Setter Property="Foreground" Value="{StaticResource MutedBrush}" />
                    <Setter Property="Background" Value="Transparent" />
                    <Setter Property="BorderThickness" Value="0" />
                    <Setter Property="Padding" Value="12,7" />
                    <Setter Property="Template">
                      <Setter.Value>
                        <ControlTemplate TargetType="TabItem">
                          <Border x:Name="TabBorder" Background="{TemplateBinding Background}" CornerRadius="8,8,0,0"
                                  Padding="{TemplateBinding Padding}">
                            <ContentPresenter ContentSource="Header" HorizontalAlignment="Center" />
                          </Border>
                          <ControlTemplate.Triggers>
                            <Trigger Property="IsSelected" Value="True">
                              <Setter TargetName="TabBorder" Property="Background" Value="#1FFFFFFF" />
                              <Setter Property="Foreground" Value="#FFFFFFFF" />
                            </Trigger>
                            <Trigger Property="IsMouseOver" Value="True">
                              <Setter Property="Foreground" Value="#FFFFFFFF" />
                            </Trigger>
                          </ControlTemplate.Triggers>
                        </ControlTemplate>
                      </Setter.Value>
                    </Setter>
                  </Style>
                </TabControl.Resources>
                <TabControl.ItemTemplate>
                  <DataTemplate DataType="{x:Type models:FenceTab}">
                    <TextBlock Text="{Binding Title}" FontSize="12" />
                  </DataTemplate>
                </TabControl.ItemTemplate>
                <TabControl.ContentTemplate>
                  <DataTemplate DataType="{x:Type models:FenceTab}">
                    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                      <ItemsControl ItemsSource="{Binding Items}">
                        <ItemsControl.ItemsPanel>
                          <ItemsPanelTemplate>
                            <WrapPanel />
                          </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                          <DataTemplate DataType="{x:Type models:DesktopItem}">
                            <Button Width="78" MinHeight="88" Margin="4" Padding="4" Background="Transparent"
                                    BorderBrush="Transparent" Foreground="#FFEAF3FA" Cursor="Hand"
                                    ToolTip="{Binding Path}"
                                    PreviewMouseLeftButtonDown="DesktopItem_MouseLeftButtonDown"
                                    PreviewMouseMove="DesktopItem_MouseMove"
                                    MouseDoubleClick="DesktopItem_MouseDoubleClick">
                              <StackPanel>
                                <Grid Width="46" Height="46" Margin="0,0,0,6">
                                  <Border Background="{Binding TileBrush}" CornerRadius="12" Opacity="0.95" />
                                  <TextBlock Text="{Binding Glyph}" FontSize="20" Foreground="#DDFFFFFF"
                                             HorizontalAlignment="Center" VerticalAlignment="Center" />
                                  <Image Source="{Binding Icon}" Width="38" Height="38" Stretch="Uniform" />
                                </Grid>
                                <TextBlock Text="{Binding Name}" FontSize="11.5" TextAlignment="Center"
                                           TextTrimming="CharacterEllipsis" MaxWidth="72" />
                                <TextBlock Text="{Binding Extension}" FontSize="9" Foreground="#FF8398AD"
                                           TextAlignment="Center" Margin="0,2,0,0" />
                              </StackPanel>
                            </Button>
                          </DataTemplate>
                        </ItemsControl.ItemTemplate>
                      </ItemsControl>
                    </ScrollViewer>
                  </DataTemplate>
                </TabControl.ContentTemplate>
              </TabControl>

              <Thumb Grid.RowSpan="2" Width="18" Height="18" HorizontalAlignment="Right" VerticalAlignment="Bottom"
                     Margin="0,0,2,2" Cursor="SizeNWSE" Background="#3065E6FF"
                     DragDelta="ResizeThumb_DragDelta" />
            </Grid>
          </Border>
        </DataTemplate>
      </ItemsControl.ItemTemplate>
    </ItemsControl>

    <Border x:Name="Toolbar" HorizontalAlignment="Center" VerticalAlignment="Top" Margin="0,16,0,0"
            Padding="8" CornerRadius="15" Background="#F00A1421" BorderBrush="#28FFFFFF" BorderThickness="1"
            Visibility="{Binding ShowToolbar, Converter={StaticResource BooleanToVisibilityConverter}}">
      <Border.Effect>
        <DropShadowEffect BlurRadius="30" ShadowDepth="8" Opacity="0.45" />
      </Border.Effect>
      <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
        <TextBlock Text="DeskNest" FontWeight="Bold" FontSize="16" VerticalAlignment="Center" Margin="8,0,12,0" />
        <Button Style="{StaticResource ToolbarButton}" Content="＋ Group" Click="AddFence_Click" />
        <Button Style="{StaticResource ToolbarButton}" Content="Refresh" Click="Refresh_Click" />
        <Button Style="{StaticResource ToolbarButton}" Content="Organize" Click="Organize_Click" />
        <Separator Margin="8,3" Background="#22FFFFFF" />
        <TextBox x:Name="SearchBox" Width="150" Height="34" Margin="2,0,8,0" Padding="10,6"
                 Background="#16FFFFFF" Foreground="White" BorderBrush="#20FFFFFF"
                 CaretBrush="#FF65E6FF" TextChanged="SearchBox_TextChanged" ToolTip="Search desktop items" />
        <ComboBox x:Name="TintCombo" Width="94" Height="34" Margin="2,0" Padding="7,4"
                  SelectionChanged="TintCombo_SelectionChanged" ToolTip="Icon tint" />
        <StackPanel Width="105" Margin="9,0,5,0">
          <TextBlock Text="Panel clarity" FontSize="9" Foreground="{StaticResource MutedBrush}" />
          <Slider Minimum="0.55" Maximum="1" Value="{Binding PanelOpacity, Mode=TwoWay}"
                  ValueChanged="OpacitySlider_ValueChanged" />
        </StackPanel>
        <CheckBox Content="Start with Windows" IsChecked="{Binding StartWithWindows, Mode=TwoWay}"
                  Foreground="#FFDCE8F2" VerticalAlignment="Center" Margin="8,0"
                  Click="StartupCheckBox_Click" />
        <Button Style="{StaticResource ToolbarButton}" Content="Hide" Click="Hide_Click" />
        <Button Style="{StaticResource ToolbarButton}" Content="Done" Click="Done_Click" />
      </StackPanel>
    </Border>

    <Border x:Name="QuickPeekBanner" HorizontalAlignment="Right" VerticalAlignment="Bottom" Margin="0,0,22,20"
            Padding="12,7" CornerRadius="9" Background="#D80A1421" BorderBrush="#4065E6FF" BorderThickness="1"
            Visibility="Collapsed">
      <TextBlock Text="QUICK PEEK · Ctrl + Alt + Space to close" FontSize="11" Foreground="#FFC7F6FF" />
    </Border>

    <Border x:Name="StatusBar" HorizontalAlignment="Left" VerticalAlignment="Bottom" Margin="20"
            Padding="11,7" CornerRadius="9" Background="#B80A1421" IsHitTestVisible="False">
      <TextBlock x:Name="StatusText" Text="Edit Mode · Ctrl + Alt + D" FontSize="11" Foreground="#FFABC0D2" />
    </Border>
  </Grid>
</Window>
